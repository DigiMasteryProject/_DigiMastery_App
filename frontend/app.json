{
  "expo": {
    "name": "DigiMastery",
    "slug": "digimastery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/digimasteryLogo.png",
    "scheme": "reactnativecine",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/digimasteryLogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.carlosrm022.digimastery"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/digimasteryLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50c5053c-f953-4a45-a127-8ff274aad1e4"
      }
    }
  }
}
